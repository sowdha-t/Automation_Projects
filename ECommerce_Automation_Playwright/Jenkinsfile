pipeline {
    agent any
        options {
                buildDiscarder(logRotator(
                            numToKeepStr: '2',
                        artifactNumToKeepStr: '2'
                 ))
        }

        stages{

            stage('Checkout'){
                steps{
                    echo "Fetching the Automation Project Repository"
                    checkout scm

                }

            }
            stage('Setup Python Environment'){
                steps{
                    dir('ECommerce_Automation_Playwright'){
                        bat '''
                            if not exist .venv (
                                python -m venv .venv
                            )
                        '''

                    }

                }

            }
            stage('Install Dependencies'){
                steps{
                    echo "Install Dependencies"
                    dir('ECommerce_Automation_Playwright'){
                         bat '''
                                .venv\\Scripts\\python -m pip install -r requirements.txt
                                .venv\\Scripts\\python -m playwright install chromium
                            '''

                    }
                }
            }
            stage('Prepare Report Directory'){
                steps{
                    dir('ECommerce_Automation_Playwright'){
                        bat 'if not exist reports\\html mkdir reports\\html'
                        bat 'if not exist reports\\screenshots mkdir reports\\screenshots'
                        bat 'if not exist logs mkdir logs'
                    }
                }

            }
            stage('Run Automation Scripts'){
                steps{
                    echo "Run Automation Scripts"
                    dir('ECommerce_Automation_Playwright'){
                        withCredentials([
                        file(credentialsId: 'ecommerce-env', variable: 'ENV_FILE')
                        ]){
                            script{
                                    bat '''
                                          echo Checking credentials file availability...
                                          if exist "%ENV_FILE%" (
                                                echo Credentials file found.
                                            ) else (
                                          echo Credentials file NOT found.
                                             exit /b 1
                                             )

                                         '''

                                            try {
                                                 bat copy /Y "%ENV_FILE%" ".env"
                                                 bat '.venv\\Scripts\\python -m pytest'
                                                } finally {
                                                     bat 'if exist .env del .env'
                                                }
                                    }
                        }
                    }

                }

            }

        }
        post{
                always{
                archiveArtifacts(
                    artifacts: 'ECommerce_Automation_Playwright/reports/**/* , ECommerce_Automation_Playwright/logs/**/*',
                    allowEmptyArchive: true
                )
                publishHTML([
                    reportDir : 'ECommerce_Automation_Playwright/reports/html',
                    reportFiles : 'report.html',
                    reportName : 'Playwright ECommerce Automation Test Report',
                    keepAll: true,
                    alwaysLinkToLastBuild: true,
                    allowMissing:true
                ])

                }

            }
}